{
  "name": "operix/auth",
  "type": "project",
  "require": {"php": "^8.3", "laravel/framework": "^12.0", "firebase/php-jwt": "^7.0"},
  "require-dev": {"phpunit/phpunit": "^11.5", "nunomaduro/collision": "^8.6", "mockery/mockery": "^1.6"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"test": "@php artisan test", "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "platform": {"php": "8.3.0"}}
}
